sensor_msgs/JointState[] joint_states
# Tool frames to report. Empty -> the robot's first tool frame, one pose per
# joint state (unchanged). Non-empty -> len(tool_frames) poses per joint state,
# config-major: poses[i * len(tool_frames) + k] is tool_frames[k] at joint_states[i].
string[] tool_frames

---
geometry_msgs/Pose[] poses
# True per joint_states[i] if that configuration is free of self-collision,
# free of scene/obstacle collision, AND within joint limits -- see
# RobotCollisionChecker.validate() in fk_services.py for exactly what this
# folds together. Was declared but never populated before -- now filled in.
std_msgs/Bool[] poses_valid
std_msgs/String error_msg