# Possible payload shape types (match AddObject.srv / SetMask.srv conventions)
int8 CUBOID=0
int8 SPHERE=1
int8 CAPSULE=2
int8 CYLINDER=3
int8 MESH=4

# Request fields
int8 type
# header.frame_id: TF frame `pose` is expressed in; "" => robot base frame.
# Typically the gripper link, so the pose is a property of the grasp and does
# not depend on where the arm currently is.
# header.stamp is IGNORED: the transform is taken at call time, to match the
# joint configuration the attachment is computed from.
std_msgs/Header header
# Only used for mesh payloads, file path must be absolute
string mesh_file_path ""
geometry_msgs/Pose pose
geometry_msgs/Vector3 dimensions
# A scene obstacle (added with add_object) to attach, by name. Non-empty -> that
# obstacle's own geometry is attached and the obstacle is disabled in the world;
# type, header, mesh_file_path, pose and dimensions are ignored. Empty -> the
# payload described by the fields above.
string object_name ""
# Robot link the payload is attached to. Empty -> "attached_object", the link a
# single-arm robot declares; a dual-arm robot declares one link per arm.
string attach_link ""
# Collision-sphere fit. FIT_DEFAULT -> the library default (MorphIt).
int8 FIT_DEFAULT=0
int8 FIT_SURFACE=1
int8 FIT_VOXEL=2
int8 FIT_MORPHIT=3
int8 sphere_fit_type 0
# Number of spheres. 0 -> estimated from the geometry and capped at the attach
# link's sphere budget (unchanged).
int32 num_spheres 0
---
# Response fields
bool success
string message
